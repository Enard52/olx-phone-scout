# ========================================
# AI ANALYSIS API KEYS (Optional)
# ========================================

# Google Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Cerebras Cloud API (https://cloud.cerebras.ai/)
# Ultra-fast inference: 2000-3000 tokens/sec
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OpenRouter API (https://openrouter.ai/keys)
# Access to multiple free models
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Vercel AI Gateway (https://vercel.com/docs/ai-gateway)
# Unified gateway to multiple providers
AI_GATEWAY_API_KEY=your_vercel_gateway_api_key_here
AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/{account_id}/{gateway_id}/openai
